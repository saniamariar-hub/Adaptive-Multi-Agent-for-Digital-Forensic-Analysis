# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure for your local environment.
# Never commit the actual .env file or real API keys to version control.
# ==============================================================================

# LLM Provider Configuration (e.g., ollama, openai, gemini, custom)
LLM_PROVIDER=ollama
LLM_MODEL_NAME=hermes3:latest
LLM_TEMPERATURE=0.1
LLM_API_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=300.0

# Optional: API Key for cloud providers (leave blank if using local Ollama)
LLM_API_KEY=

# Forensic Analysis Thresholds
CONFIDENCE_THRESHOLD=0.70
MAX_EVIDENCE_PER_BATCH=50
DEFAULT_TIMEZONE=UTC
